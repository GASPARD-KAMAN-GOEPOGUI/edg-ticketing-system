# ─── Configuration de DÉVELOPPEMENT — copier en « .env » (même dossier) ──────
# Noms alignés sur api/configs/Environment.py (seule source de vérité).
# Production : voir .env.production.example.

# Application
APP_NAME=EDG Support API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG_MODE=false
PORT=8000

# Base de données
DATABASE_DIALECT=mysql+aiomysql
DATABASE_HOSTNAME=localhost
DATABASE_PORT=3306
DATABASE_NAME=edg_ticketing
DATABASE_USERNAME=root
DATABASE_PASSWORD=

# Plateforme centrale d'authentification manager-user
CENTRAL_AUTH_BASE_URL=https://appsecu.edgportal.com
CLIENT_APP_CODE=
CLIENT_APP_SECRET=
HTTP_TIMEOUT_MS=20000
CENTRAL_AUTH_CACHE_TTL=180

# Sécurité (en développement, CORS accepte toutes les origines)
DISABLE_AUTH=False
ENCRYPTION_KEY=

# Redis (optionnel en développement : repli en mémoire si vide)
REDIS_URL=

# Fichiers : vide = backend/uploads
UPLOADS_DIR=

# Antivirus
CLAMAV_ENABLED=False

# SMTP (vide = aucun e-mail envoyé)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMS (vide = aucun SMS envoyé)
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER=EDG

# Organigramme de référence réinséré au démarrage
SEED_ORG_STRUCTURE=True

# Tâches planifiées (J+3 / J+4) dans le processus web (dev)
SCHEDULER_IN_PROCESS=True
