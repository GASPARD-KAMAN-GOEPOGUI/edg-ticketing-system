# ─── TEMPLATE DE PRODUCTION — NE JAMAIS COMMITTER LE FICHIER .env.production RÉEL
# Copier : cp backend/.env.production.example backend/.env.production
# Puis remplir toutes les valeurs marquées CHANGEME

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=EDG Connect API
APP_VERSION=1.0.0
APP_ENV=production
DEBUG_MODE=false
PORT=8000

# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_DIALECT=mysql+aiomysql
DATABASE_HOSTNAME=db
DATABASE_PORT=3306
DATABASE_NAME=edg_ticketing
DATABASE_USERNAME=edg_user
DATABASE_PASSWORD=CHANGEME_strong_password_32chars

# ─── Plateforme centrale d'authentification manager-user ──────────────────────
CENTRAL_AUTH_BASE_URL=https://appsecu.edgportal.com
CLIENT_APP_CODE=CHANGEME_client_app_code
CLIENT_APP_SECRET=CHANGEME_client_app_secret
HTTP_TIMEOUT_MS=20000

# ─── Auth ─────────────────────────────────────────────────────────────────────
DISABLE_AUTH=False

# ─── CORS (remplacer par le vrai domaine) ────────────────────────────────────
CORS_ORIGINS=["https://edg-connect.gn"]

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGEME_redis_password@redis:6379/0

# ─── SMTP ─────────────────────────────────────────────────────────────────────
# Utiliser un compte dédié EDG, PAS un compte Gmail personnel
SMTP_HOST=mail.edg.gn
SMTP_PORT=587
SMTP_USER=no-reply@edg.gn
SMTP_PASSWORD=CHANGEME_smtp_password

# ─── ClamAV ───────────────────────────────────────────────────────────────────
CLAMAV_ENABLED=True
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOADS_PATH=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Sauvegarde ───────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
