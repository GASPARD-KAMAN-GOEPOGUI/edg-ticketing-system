# ══════════════════════════════════════════════════════════════════════════════
# EDG Support API — MODÈLE DE CONFIGURATION DE PRODUCTION (cPanel)
# Backend : https://appsupport.edgportal.com · Frontend : https://support.edgportal.com
# ══════════════════════════════════════════════════════════════════════════════
#
# INSTALLATION
#   1. Copier ce fichier sous le nom « .env » dans le DOSSIER DE L'APPLICATION
#      Python (celui qui contient passenger_wsgi.py et api/) :
#        cp .env.production.example .env
#      Le code lit uniquement « .env » (Environment.Config.env_file) ;
#      passenger_wsgi.py se place dans ce dossier avant de charger l'app.
#   2. Ce dossier doit être HORS de public_html (jamais servi par Apache).
#   3. Permissions : lecture/écriture pour le seul propriétaire :
#        chmod 600 .env
#   4. Remplacer chaque valeur CHANGEME, puis redémarrer l'application
#      (« Restart » dans Setup Python App).
#   Ne JAMAIS committer le fichier .env réel.
#
# PRIORITÉ DES SOURCES (pydantic v1 BaseSettings)
#   Une variable d'environnement du processus passe AVANT la même variable du
#   .env. Les variables saisies dans l'interface « Setup Python App » de cPanel
#   sont injectées comme variables d'environnement par Passenger : elles
#   L'EMPORTENT donc sur ce fichier. Conseil : tout définir ici, et ne rien
#   saisir dans l'interface (une seule source de vérité).
#
# FORMAT
#   Les listes (CORS_ORIGINS) s'écrivent en JSON : ["https://exemple"].
#   Les booléens acceptent true/false (insensible à la casse).
# ══════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=EDG Support API
APP_VERSION=1.0.0
# « production » active : CORS restreint à CORS_ORIGINS, et les gardes de
# démarrage (DISABLE_AUTH interdit, plateforme centrale et REDIS_URL requis).
APP_ENV=production
DEBUG_MODE=false
# Ignoré sous Passenger (le port est géré par Apache) ; conservé pour uvicorn.
PORT=8000

# ─── Base de données MySQL (cPanel) ───────────────────────────────────────────
# Sur cPanel, base et utilisateur sont préfixés par le compte : <user>_xxx.
# L'utilisateur doit avoir TOUS les privilèges sur la base (création des tables).
DATABASE_DIALECT=mysql+aiomysql
DATABASE_HOSTNAME=localhost
DATABASE_PORT=3306
DATABASE_NAME=CHANGEME_user_edg_ticketing
DATABASE_USERNAME=CHANGEME_user_edg
DATABASE_PASSWORD=CHANGEME_mot_de_passe_fort

# ─── Plateforme centrale d'authentification (manager-user) ───────────────────
# Requis en production. Le serveur doit pouvoir joindre cette URL en HTTPS.
CENTRAL_AUTH_BASE_URL=https://appsecu.edgportal.com
CLIENT_APP_CODE=CHANGEME_client_app_code
CLIENT_APP_SECRET=CHANGEME_client_app_secret
HTTP_TIMEOUT_MS=20000
# Cache (s) des scopes/groupes centraux. Une révocation côté central met
# jusqu'à cette durée à être vue. 0 = désactivé (un appel par requête).
CENTRAL_AUTH_CACHE_TTL=180

# ─── Sécurité ─────────────────────────────────────────────────────────────────
# Toujours False en production (le démarrage échoue sinon).
DISABLE_AUTH=False
# Origine EXACTE du frontend : schéma https, sans slash final, format JSON.
CORS_ORIGINS=["https://support.edgportal.com"]
# Proxies de confiance (IP ou plages CIDR, JSON). L'en-tête X-Forwarded-For,
# falsifiable par n'importe quel client, n'est lu que pour une connexion venant
# de l'un d'eux. VIDE sur cPanel où Apache/Passenger reçoit directement le
# client (REMOTE_ADDR = IP réelle). À renseigner UNIQUEMENT si l'hébergeur place
# un proxy devant Apache (nginx, Cloudflare…) : sinon la limitation des
# tentatives de connexion et l'IP du journal d'audit seraient contournables.
TRUSTED_PROXIES=[]
# Clé Fernet (base64-url, 32 octets). Vide = chiffrement désactivé.
# BASE IMPORTÉE DEPUIS LA BASE LOCALE : reprendre EXACTEMENT la même clé que
# le .env local. Une valeur préfixée « enc: » chiffrée avec une autre clé
# resterait illisible (renvoyée telle quelle, sans erreur visible).
# État constaté (lot 2) : l'application ne chiffre rien (encrypt_field n'est
# appelé nulle part depuis le premier commit) et le dump db/edg_ticketing.sql
# ne contient aucune valeur « enc: » ; reprendre la clé reste la seule
# configuration sûre si la base réelle en contenait.
# Base vierge : générer une nouvelle clé :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGEME_meme_cle_que_le_env_local

# ─── Redis ────────────────────────────────────────────────────────────────────
# Requis en production par la garde de démarrage. Redis n'est PAS disponible
# sur cet hébergement : l'alternative (état partagé en base MySQL) est prévue
# au lot 4. Tant qu'elle n'est pas livrée, le backend refuse de démarrer avec
# APP_ENV=production.
# REDIS_URL=redis://:mot_de_passe@hote:6379/0

# ─── Fichiers (pièces jointes, avatars) ───────────────────────────────────────
# Chemin ABSOLU, hors du dossier de l'application ET hors de public_html :
# les fichiers survivent ainsi aux redéploiements et ne sont jamais servis
# directement par Apache. Créé automatiquement au démarrage s'il manque.
UPLOADS_DIR=/home/CHANGEME_user/edg-data/uploads

# ─── Antivirus ClamAV ─────────────────────────────────────────────────────────
# Pas de démon clamd sur cPanel mutualisé : désactivé. Les contrôles de type
# réel (magic bytes), de taille et de nombre de pièces restent actifs.
CLAMAV_ENABLED=False
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# ─── E-mail (SMTP) ────────────────────────────────────────────────────────────
# Compte de messagerie créé dans cPanel (ex. no-reply@edgportal.com).
# SMTP_HOST vide = aucun e-mail envoyé.
SMTP_HOST=mail.edgportal.com
SMTP_PORT=587
SMTP_USER=no-reply@edgportal.com
SMTP_PASSWORD=CHANGEME_mot_de_passe_smtp

# ─── SMS (passerelle HTTP générique) ──────────────────────────────────────────
# SMS_GATEWAY_URL vide = aucun SMS envoyé.
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER=EDG

# ─── Données de référence ─────────────────────────────────────────────────────
# Appliquées par « python -m api.cli init » (jamais d'écrasement ni de
# suppression ; statuts, catégories, priorités et SLA manquants toujours ajoutés).
# PRODUCTION : False. L'organigramme vient de la base importée et est géré par
# l'admin. Avec True, toute unité de référence dont le codename a disparu
# (renommée ou supprimée définitivement par l'admin) serait RÉINSÉRÉE, créant
# un doublon apparent dans l'organigramme.
SEED_ORG_STRUCTURE=False

# ─── Tâches planifiées ────────────────────────────────────────────────────────
# PRODUCTION : False. Passenger n'exécute pas le démarrage FastAPI (lifespan) et
# lance plusieurs processus : la validation d'office (J+3) et la fermeture
# (J+4) sont exécutées par le cron horaire « python -m api.cli cycle »
# (verrou en base, table app_lock). True = scheduler dans le processus web (dev).
SCHEDULER_IN_PROCESS=False
