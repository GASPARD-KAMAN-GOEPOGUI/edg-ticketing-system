# ─── Secrets & Environnements ─────────────────────────────────────────────────
.env
.env.local
.env.production
.env.*.local
backend/.env
backend/.env.production
frontend/.env.development
frontend/.env.local
# Exception : le .env.production du frontend ne contient que des VITE_* publics
# (intégrés au JS livré au navigateur), jamais de secret.
!frontend/.env.production
secrets/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ─── Docker ───────────────────────────────────────────────────────────────────
# Ne PAS ignorer docker-compose.yml — il doit être versionné

# ─── Uploads & données ────────────────────────────────────────────────────────
# uploads : on versionne la structure (.gitkeep), jamais les fichiers des utilisateurs
backend/uploads/**
!backend/uploads/**/
!backend/uploads/**/.gitkeep
*.tar.gz
backups/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
backend/logs/
nginx/logs/

# ─── Artefacts locaux Codex ───────────────────────────────────────────────────
/.codex/
/.codex-*.log
/.codex-build-*.err
/.codex-build-*.out
/.codex-chrome-profile*/
/.codex-edge-supervision-profile*/
/.codex-visual-tests/

# ─── Certificats SSL ──────────────────────────────────────────────────────────
nginx/certs/
*.pem
*.key
*.crt

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ─── Dossiers non versionnés ──────────────────────────────────────────────────
edgrh/
monitoring/
nginx/

# Dumps SQL : jamais versionnés (données personnelles) — seul le schéma vide l'est
backend/db/*.sql
!backend/db/schema.sql
